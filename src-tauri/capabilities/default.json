{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-app-write-recursive",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "log:default",
    "core:window:allow-set-icon"
  ]
}
